{
  "name": "dsh-session-stats-panel",
  "version": "0.1.0",
  "description": "DeepSeek Harness (cordis) client plugin: a right-side session stats panel showing average cache-hit rate, session cost, runtime, request count and cumulative tokens (DeepSeek pricing).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1113622001/dsh-session-stats-panel.git"
  },
  "homepage": "https://github.com/a1113622001/dsh-session-stats-panel",
  "bugs": {
    "url": "https://github.com/a1113622001/dsh-session-stats-panel/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web",
    "ui",
    "session",
    "stats",
    "token-usage"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
